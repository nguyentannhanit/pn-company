{
  "name": "pn-company",
  "version": "0.1.0",
  "private": true,
  "description": "P&N \u2014 AI Digital Product Company platform. Build. Learn. Evolve.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "typecheck": "node ./node_modules/typescript/bin/tsc --build --verbose && npm run typecheck:web",
    "typecheck:clean": "node ./node_modules/typescript/bin/tsc --build --clean",
    "build": "node ./node_modules/typescript/bin/tsc --build",
    "lint": "node ./node_modules/eslint/bin/eslint.js . --max-warnings=0",
    "lint:fix": "node ./node_modules/eslint/bin/eslint.js . --fix",
    "format": "node ./node_modules/prettier/bin/prettier.cjs --write \"**/*.{ts,tsx,md,json,sql}\"",
    "format:check": "node ./node_modules/prettier/bin/prettier.cjs --check \"**/*.{ts,tsx,md,json,sql}\"",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "verify": "npm run typecheck && npm run lint && npm test",
    "db:migrate": "npm run build && node --env-file-if-exists=.env packages/database/dist/cli.js migrate",
    "db:status": "npm run build && node --env-file-if-exists=.env packages/database/dist/cli.js status",
    "typecheck:web": "node ./node_modules/typescript/bin/tsc --noEmit -p apps/web/tsconfig.json",
    "build:web": "node ./node_modules/next/dist/bin/next build apps/web",
    "dev:api": "npm run build && node --env-file-if-exists=.env apps/api/dist/index.js",
    "dev:web": "node ./node_modules/next/dist/bin/next dev apps/web -p 3000",
    "dev:bot": "npm run build && node --env-file-if-exists=.env apps/telegram-bot/dist/index.js",
    "dev:worker": "npm run build && node --env-file-if-exists=.env apps/worker/dist/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^4.1.11"
  }
}
