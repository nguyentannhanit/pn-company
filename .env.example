# =============================================================================
# P&N — Environment template
# Copy to .env and fill in. NEVER commit .env (spec §19, §69, §89).
# API keys of AI providers / integrations are NOT stored here in production —
# they live encrypted in the database via packages/secrets (API Center, §47, §69).
# Only the master encryption key and infrastructure connection strings live here.
# =============================================================================

NODE_ENV=development

# --- Branding (§150.11) — overrides packages/shared/src/branding.ts defaults ---
PN_COMPANY_NAME=P&N
PN_COMPANY_SHORT_NAME=P&N
PN_COMPANY_TAGLINE=Build. Learn. Evolve.

# --- Database (§61) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pn_company
DATABASE_SSL=false

# --- Redis / queue (§23) ---
REDIS_URL=redis://localhost:6379

# --- Secret store master key (§69) -------------------------------------------
# 32 bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key invalidates every stored secret until re-encrypted (§70).
PN_MASTER_KEY=

# --- Auth ---
JWT_SECRET=
SESSION_TTL_HOURS=12

# --- API / Web ---
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
# Origin khác được phép gọi API từ trình duyệt (dashboard trên Vercel…), cách nhau dấu phẩy.
# Đường hầm Cloudflare (tools/tunnel.ps1) tự ghi WEB_TUNNEL_ORIGIN vào logs/tunnel.env.
WEB_EXTRA_ORIGINS=

# --- Secret dùng chung giữa các tiến trình nội bộ ------------------------------
# Bot và worker dùng secret này để xin cấu hình/phiên từ API. Chúng KHÔNG giữ
# PN_MASTER_KEY, nên chỉ tiến trình API giải mã được secret (§19, §69).
PN_SERVICE_SECRET=

# --- Telegram (§57, §58) ------------------------------------------------------
# Ưu tiên cấu hình trong API Center (đã mã hoá). Hai biến dưới chỉ để chạy nhanh
# lúc phát triển; allowlist rỗng nghĩa là mọi chat đều gọi được — không dùng ở production.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# --- GitHub (§59) -------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_DEFAULT_ORG=

# --- Sandbox (§18) ------------------------------------------------------------
# local  = chay thang tren may, khong gioi han RAM/CPU va khong cat duoc mang
# docker = cach ly that o muc kernel; can Docker Desktop dang chay
SANDBOX_DRIVER=local
SANDBOX_IMAGE=node:22-bookworm-slim
SANDBOX_ROOT=./workspaces
SANDBOX_TIMEOUT_MS=1800000
SANDBOX_MAX_MEMORY_MB=2048

# --- Budget defaults (§54, §55) ----------------------------------------------
DEFAULT_PROJECT_BUDGET_USD=20
BUDGET_WARN_THRESHOLD=0.8
BUDGET_HARD_STOP=true

# --- Knowledge & R&D (§106, §131, §132) ---------------------------------------
# daily = chay mot vong kham pha moi ngay. Bo trong = tat.
# Moi vong ton tien model nen mac dinh TAT.
KNOWLEDGE_DISCOVERY=
KNOWLEDGE_DISCOVERY_HOUR=7
# Chu de phong ban dang can, ngan bang dau phay
KNOWLEDGE_TOPICS=
KNOWLEDGE_DIGEST_TELEGRAM=false
